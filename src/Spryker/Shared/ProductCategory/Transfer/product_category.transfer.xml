<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="ProductCategory">
        <property name="idProductCategory" type="int"/>
        <property name="fkProductAbstract" type="int"/>
        <property name="fkCategory" type="int"/>
        <property name="productOrder" type="int"/>
        <property name="category" type="Category"/>
    </transfer>

    <transfer name="ProductCategoryCollection">
        <property name="productCategories" type="ProductCategory[]" singular="productCategory"/>
        <property name="pagination" type="Pagination"/>
    </transfer>

    <transfer name="ProductCategoryCriteria">
        <property name="productCategoryConditions" type="ProductCategoryConditions"/>
        <property name="sortCollection" type="Sort[]" singular="sort"/>
        <property name="pagination" type="Pagination"/>
    </transfer>

    <transfer name="ProductCategoryConditions">
        <property name="localeIds" type="int[]" singular="idLocale"/>
        <property name="productAbstractIds" type="int[]" singular="idProductAbstract"/>
        <property name="categoryIds" type="int[]" singular="idCategory"/>
    </transfer>

    <transfer name="Pagination">
        <property name="limit" type="int"/>
        <property name="offset" type="int"/>
        <property name="nbResults" type="int"/>
    </transfer>

    <transfer name="Sort">
        <property name="field" type="string"/>
        <property name="isAscending" type="bool"/>
    </transfer>

    <transfer name="LocalizedAttributes">
        <property name="name" type="string"/>
        <property name="locale" type="Locale"/>
        <property name="attributes" type="array" singular="attribute"/>
    </transfer>

    <transfer name="Category">
        <property name="categoryNode" type="Node"/>
        <property name="idCategory" type="int"/>
        <property name="localizedAttributes" type="CategoryLocalizedAttributes[]" singular="localizedAttributes"/>
        <property name="nodeCollection" type="NodeCollection"/>
        <property name="parentCategoryNode" type="Node"/>
        <property name="name" type="string"/>
    </transfer>

    <transfer name="Locale">
        <property name="idLocale" type="int"/>
        <property name="localeName" type="string"/>
        <property name="name" type="string"/>
    </transfer>

    <transfer name="CategoryLocalizedAttributes">
        <property name="locale" type="Locale"/>
        <property name="name" type="string"/>
    </transfer>

    <transfer name="CategoryCollection">
        <property name="categories" type="Category[]" singular="category"/>
    </transfer>

    <transfer name="Node">
        <property name="idCategoryNode" type="int"/>
        <property name="category" type="Category"/>
        <property name="childrenNodes" type="NodeCollection"/>
        <property name="isRoot" type="bool"/>
        <property name="fkParentCategoryNode" type="int"/>
        <property name="fkCategory" type="int"/>
    </transfer>

    <transfer name="ProductAbstract">
        <property name="categoryIds" type="int[]" singular="idCategory"/>
        <property name="productCategories" type="ProductCategory[]" singular="productCategory" strict="true"/>
        <property name="categoryUuids" type="string[]" singular="categoryUuid" strict="true"/>
        <property name="idProductAbstract" type="int"/>
        <property name="sku" type="string"/>
        <property name="localizedAttributes" type="LocalizedAttributes[]" singular="localizedAttributes"/>
    </transfer>

    <transfer name="ProductAbstractRelations" strict="true">
        <property name="withProductCategories" type="bool"/>
        <property name="withLocalizedAttributes" type="bool"/>
    </transfer>

    <transfer name="ProductAbstractConditions" strict="true">
        <property name="ids" type="array" singular="id"/>
    </transfer>

    <transfer name="ProductConcrete">
        <property name="productCategories" type="ProductCategory[]" singular="productCategory"/>
        <property name="relatedCategoryTreeNodes" type="Node[]" singular="relatedCategoryTreeNode"/>
        <property name="fkProductAbstract" type="int"/>
    </transfer>

    <transfer name="EventEntity">
        <property name="id" type="int"/>
        <property name="name" type="string"/>
        <property name="foreignKeys" type="array" singular="foreignKeys"/>
    </transfer>

    <transfer name="CategoryCriteria">
        <property name="isRoot" type="bool" deprecated="Use CategoryConditions.isRoot instead."/>
        <property name="withChildrenRecursively" type="bool"/>
        <property name="categoryConditions" type="CategoryConditions" strict="true"/>
    </transfer>

    <transfer name="NodeCollection">
        <property name="nodes" type="Node[]" singular="node"/>
    </transfer>

    <transfer name="AclEntityMetadataConfig">
        <property name="aclEntityMetadataCollection" type="AclEntityMetadataCollection"/>
    </transfer>

    <transfer name="AclEntityMetadata">
        <property name="entityName" type="string"/>
        <property name="parent" type="AclEntityParentMetadata"/>
        <property name="isSubEntity" type="bool"/>
    </transfer>

    <transfer name="AclEntityParentMetadata">
        <property name="entityName" type="string"/>
    </transfer>

    <transfer name="AclEntityMetadataCollection">
        <property name="collection" type="array" singular="aclEntityMetadata" associative="true"/>
    </transfer>

    <transfer name="CategoryConditions" strict="true">
        <property name="categoryIds" type="int[]" singular="idCategory"/>
        <property name="categoryKeys" type="string[]" singular="categoryKey" strict="true" description="A collection of unique keys for categories."/>
    </transfer>

    <transfer name="ProductAbstractCollection">
        <property name="productAbstracts" type="ProductAbstract[]" singular="productAbstract"/>
    </transfer>

    <transfer name="ProductAbstractCriteria" strict="true">
        <property name="productAbstractConditions" type="ProductAbstractConditions"/>
        <property name="productAbstractRelations" type="ProductAbstractRelations"/>
    </transfer>

    <transfer name="Item">
        <property name="idProductAbstract" type="int"/>
        <property name="categoryPath" type="string[]" singular="categoryName" description="The category names of the product, top level first, without the root category: set when the item is added to the cart, in the locale of that moment, and read from storage when the order details page shows an order item."/>
    </transfer>

    <transfer name="CartChange">
        <property name="items" type="Item[]" singular="item"/>
    </transfer>

    <transfer name="Store">
        <property name="idStore" type="int"/>
    </transfer>

    <transfer name="CategoryPathNode" strict="true">
        <property name="idCategory" type="int" description="The ID of the category."/>
        <property name="name" type="string" description="The name of the category in the locale of the path."/>
        <property name="parentCategoryIds" type="int[]" singular="idParentCategory" description="The IDs of the parent categories of the category."/>
    </transfer>

    <transfer name="CategoryPathNodeCollection" strict="true">
        <property name="nodes" type="CategoryPathNode[]" singular="node" description="The categories of a product with the categories above them; the categories without a parent among them are the top level."/>
    </transfer>
</transfers>
